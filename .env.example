# ==============================================================================
# Ashish Agrawal Portfolio - Email & SMTP Server Configuration
# ==============================================================================

# Server Port
PORT=3000

# Recipient Email (where you receive submissions)
NOTIFICATION_RECIPIENT=ashishagrwal307@gmail.com

# Email Sender Branding
SENDER_NAME=Ashish Agrawal Portfolio
SENDER_EMAIL=ashishagrwal307@gmail.com

# ------------------------------------------------------------------------------
# 1. GMAIL CONFIGURATION (Recommended for personal portfolios)
# ------------------------------------------------------------------------------
# NOTE: Do NOT use your regular Gmail password. Generate an "App Password":
# 1. Go to your Google Account (https://myaccount.google.com/security)
# 2. Enable 2-Step Verification if not already enabled.
# 3. Search for "App passwords" (https://myaccount.google.com/apppasswords).
# 4. Create a new app name (e.g. "Portfolio Website") and copy the 16-character code.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=ashishagrwal307@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx

# ------------------------------------------------------------------------------
# 2. OUTLOOK / OFFICE 365 CONFIGURATION
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@outlook.com
# SMTP_PASS=your_password

# ------------------------------------------------------------------------------
# 3. YAHOO MAIL CONFIGURATION
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@yahoo.com
# SMTP_PASS=your_yahoo_app_password

# ------------------------------------------------------------------------------
# 4. CUSTOM / TRANSACTIONAL SMTP (SendGrid, Brevo, Mailgun, Amazon SES)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_login
# SMTP_PASS=your_api_key

# NOTE: If SMTP_USER and SMTP_PASS are left blank, the server automatically
# creates an Ethereal test inbox and outputs instant email preview URLs in the console!
